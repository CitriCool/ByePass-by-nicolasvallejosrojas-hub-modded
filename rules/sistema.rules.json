        },
        "nacimiento": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "playerId": {
          ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^[0-9]{6,8}$/))"
        },
        "publico": {
          ".validate": "newData.isBoolean()"
        },
        "creado": {
          ".validate": "newData.isNumber() && newData.val() <= now + 5000 && (!data.exists() || newData.val() === data.val())"
        },
        "invitacion": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{8,20}$/)"
        },
        "$otro": {
          ".validate": false
        }
      }
    },
    "beta": {
