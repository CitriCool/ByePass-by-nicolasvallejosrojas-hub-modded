{
  "rules": {
    ".read": false,
    ".write": false,
    "usuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (root.child('beta/activa').val() !== true || data.exists() || (newData.child('invitacion').isString() && !root.child('beta/codigos').child(newData.child('invitacion').val()).child('quienes').child($uid).exists() && newData.parent().parent().child('beta/codigos').child(newData.child('invitacion').val()).child('quienes').child($uid).exists() && newData.parent().parent().child('beta/codigos').child(newData.child('invitacion').val()).child('usados').val() === root.child('beta/codigos').child(newData.child('invitacion').val()).child('usados').val() + 1 && newData.parent().parent().child('beta/codigos').child(newData.child('invitacion').val()).child('usados').val() <= root.child('beta/codigos').child(newData.child('invitacion').val()).child('max').val()))",
        ".validate": "newData.hasChildren(['nombre','nacimiento','playerId','publico','creado'])",
        "nombre": {
