{
  "rules": {
    ".read": false,
    ".write": false,
    "usuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (root.child('beta/activa').val() !== true || data.exists() || (newData.child('invitacion').isString() && !root.child('beta/codigos').child(newData.child('invitacion').val()).child('quienes').child($uid).exists() && newData.parent().parent().child('beta/codigos').child(newData.child('invitacion').val()).child('quienes').child($uid).exists() && newData.parent().parent().child('beta/codigos').child(newData.child('invitacion').val()).child('usados').val() === root.child('beta/codigos').child(newData.child('invitacion').val()).child('usados').val() + 1 && newData.parent().parent().child('beta/codigos').child(newData.child('invitacion').val()).child('usados').val() <= root.child('beta/codigos').child(newData.child('invitacion').val()).child('max').val()))",
        ".validate": "newData.hasChildren(['nombre','nacimiento','playerId','publico','creado'])",
        "nombre": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 80" },
        "nacimiento": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
        "playerId": { ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^[0-9]{6,8}$/))" },
        "publico": { ".validate": "newData.isBoolean()" },
        "creado": { ".validate": "newData.isNumber() && newData.val() <= now + 5000 && (!data.exists() || newData.val() === data.val())" },
        "invitacion": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{8,20}$/)" },
        "$otro": { ".validate": false }
      }
    },
    "beta": {
      "activa": { ".read": true },
      "codigos": {
        "$codigo": {
          "max": { ".read": true },
          "usados": {
            ".read": true,
            ".write": "auth != null && root.child('beta/activa').val() === true && newData.isNumber() && newData.val() === data.val() + 1 && newData.val() <= newData.parent().child('max').val() && !root.child('beta/codigos').child($codigo).child('quienes').child(auth.uid).exists() && newData.parent().child('quienes').child(auth.uid).exists() && newData.parent().parent().parent().parent().child('usuarios').child(auth.uid).child('invitacion').val() === $codigo"
          },
          "quienes": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.isNumber() && root.child('beta/activa').val() === true && newData.parent().parent().child('usados').val() === root.child('beta/codigos').child($codigo).child('usados').val() + 1 && newData.parent().parent().child('usados').val() <= newData.parent().parent().child('max').val() && newData.parent().parent().parent().parent().parent().child('usuarios').child($uid).child('invitacion').val() === $codigo"
            }
          }
        }
      },
      "testers": {
        "$uid": {
          ".read": true,
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.val() === true && newData.parent().parent().parent().child('usuarios').child($uid).child('invitacion').isString() && newData.parent().parent().parent().child('beta/codigos').child(newData.parent().parent().parent().child('usuarios').child($uid).child('invitacion').val()).child('quienes').child($uid).exists()"
        }
      }
    }
  }
}
